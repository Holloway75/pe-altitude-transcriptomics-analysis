# shellcheck shell=bash
# Machine-specific paths only. Every default can be overridden by an
# environment variable of the same name.

EXTERNAL_DATA_ROOT="${EXTERNAL_DATA_ROOT:-/home/holloway/data}"
CONDA_ROOT="${CONDA_ROOT:-/home/holloway/programs/miniconda3}"
# 2026-09-10 (audit B-7): the former default ~/.local/share/mamba/envs/htstools
# no longer exists; tabix/bgzip are provided by the bio_mr environment (the
# same environment split as plink2/Rscript).
HTS_TOOLS_ROOT="${HTS_TOOLS_ROOT:-${CONDA_ROOT}/envs/bio_mr/bin}"
REFERENCE_GENOME_ROOT="${REFERENCE_GENOME_ROOT:-${EXTERNAL_DATA_ROOT}/RefGenome}"
HG19_FASTA="${HG19_FASTA:-${REFERENCE_GENOME_ROOT}/GRCh37/hs37d5/hs37d5.fa}"
HG19_FASTA_FAI="${HG19_FASTA_FAI:-${HG19_FASTA}.fai}"
HG38_FASTA="${HG38_FASTA:-${REFERENCE_GENOME_ROOT}/GRCh38/primary_assembly/hg38_chr1_22.fa}"
HG38_FASTA_FAI="${HG38_FASTA_FAI:-${HG38_FASTA}.fai}"
DBSNP_HG38_VCF="${DBSNP_HG38_VCF:-${EXTERNAL_DATA_ROOT}/dbSNP/hg38_build157/dbsnp_fixchr.vcf.gz}"

PE_GWAS_ROOT="${PE_GWAS_ROOT:-${EXTERNAL_DATA_ROOT}/GWAS_summary/05_outcomes/PE}"
GEO_ROOT="${GEO_ROOT:-${EXTERNAL_DATA_ROOT}/GEO}"
JTI_MODEL_DIR="${JTI_MODEL_DIR:-${EXTERNAL_DATA_ROOT}/JTI_model}"
MSIGDB_ROOT="${MSIGDB_ROOT:-${EXTERNAL_DATA_ROOT}/MSigDB/2024.1.Hs}"
MAGMA_GENE_LOC="${MAGMA_GENE_LOC:-${EXTERNAL_DATA_ROOT}/MAGMA/v1.10/NCBI37.3/NCBI37.3.gene.loc}"
GTEX_V8_BESD_DIR="${GTEX_V8_BESD_DIR:-${EXTERNAL_DATA_ROOT}/GTEx/Yang_Lab_SMR_GTEx_V8_cis_eqtl_summary}"
LD_REF_HG19_DIR="${LD_REF_HG19_DIR:-${EXTERNAL_DATA_ROOT}/1kGenome/hg19_plink_binary_eur}"
LD_REF_HG38_DIR="${LD_REF_HG38_DIR:-${EXTERNAL_DATA_ROOT}/1kGenome/hg38_plink_binary_eur}"
HG19_VCF_DIR="${HG19_VCF_DIR:-${EXTERNAL_DATA_ROOT}/1kGenome/hg19_vcf}"
HM3_LIST="${HM3_LIST:-${EXTERNAL_DATA_ROOT}/LDSC_Ref/reference_data/w_hm3.snplist}"
PUBLIC_LDSC_DIR="${PUBLIC_LDSC_DIR:-${EXTERNAL_DATA_ROOT}/LDSC_Ref/reference_data}"

PYTHON_DEFAULT="${PYTHON_DEFAULT:-${CONDA_ROOT}/bin/python}"
PYTHON_METAXCAN="${PYTHON_METAXCAN:-${CONDA_ROOT}/envs/metaxcan/bin/python}"
PLINK2="${PLINK2:-${CONDA_ROOT}/envs/bio_mr/bin/plink2}"
MAGMA="${MAGMA:-${CONDA_ROOT}/envs/deg/bin/magma}"
TABIX="${TABIX:-${HTS_TOOLS_ROOT}/tabix}"
BGZIP="${BGZIP:-${HTS_TOOLS_ROOT}/bgzip}"
BCFTOOLS="${BCFTOOLS:-/usr/bin/bcftools}"
RSCRIPT="${RSCRIPT:-${CONDA_ROOT}/envs/bio_mr/bin/Rscript}"
GCTA="${GCTA:-${CONDA_ROOT}/envs/bio_mr/bin/gcta64}"
PANDOC="${PANDOC:-${CONDA_ROOT}/envs/pe_manuscript/bin/pandoc}"

INTERIM_DIR="${INTERIM_DIR:-${PROJECT_ROOT}/work}"
PROCESSED_DIR="${PROCESSED_DIR:-${PROJECT_ROOT}/data/processed}"
RESULTS_DIR="${RESULTS_DIR:-${PROJECT_ROOT}/results}"
TOOLS_DIR="${TOOLS_DIR:-${PROJECT_ROOT}/tools}"
PE_GENETIC_INTERIM_DIR="${PE_GENETIC_INTERIM_DIR:-${INTERIM_DIR}/01_pe_genetic_map}"
PE_GENETIC_RESULT_DIR="${PE_GENETIC_RESULT_DIR:-${RESULTS_DIR}/01_pe_genetic_map}"
ALTITUDE_RESULT_DIR="${ALTITUDE_RESULT_DIR:-${RESULTS_DIR}/02_altitude_response}"
CORE_CANDIDATE_RESULT_DIR="${CORE_CANDIDATE_RESULT_DIR:-${RESULTS_DIR}/04_core_candidates}"
